# Risk gateway + IBKR adapter only (no Next build). Paper-only: the daemon refuses non-DU accounts and live ports.
FROM node:22-slim
WORKDIR /app
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
USER node
EXPOSE 8080
CMD ["npx", "tsx", "src/gateway/main.ts"]
